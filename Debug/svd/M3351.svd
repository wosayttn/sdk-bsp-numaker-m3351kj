       <register>
          <name>PWM_SWEOFTRG</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>PWM_SWEOFTRG</displayName>
          <description>PWM Software Event Output Force Trigger Register</description>
          <addressOffset>0x28C</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>SWETRG0</name>
              <description>Software Event Trigger\nWrite 1 to this bit will change PWM output status according to OUTACTSn in PWMx_SWEOFCTL setting.\nNote: This bit will auto cleared by hardware.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SWETRG1</name>
              <description>Software Event Trigger\nWrite 1 to this bit will change PWM output status according to OUTACTSn in PWMx_SWEOFCTL setting.\nNote: This bit will auto cleared by hardware.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SWETRG2</name>
              <description>Software Event Trigger\nWrite 1 to this bit will change PWM output status according to OUTACTSn in PWMx_SWEOFCTL setting.\nNote: This bit will auto cleared by hardware.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SWETRG3</name>
              <description>Software Event Trigger\nWrite 1 to this bit will change PWM output status according to OUTACTSn in PWMx_SWEOFCTL setting.\nNote: This bit will auto cleared by hardware.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SWETRG4</name>
              <description>Software Event Trigger\nWrite 1 to this bit will change PWM output status according to OUTACTSn in PWMx_SWEOFCTL setting.\nNote: This bit will auto cleared by hardware.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SWETRG5</name>
              <description>Software Event Trigger\nWrite 1 to this bit will change PWM output status according to OUTACTSn in PWMx_SWEOFCTL setting.\nNote: This bit will auto cleared by hardware.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
       </register>
