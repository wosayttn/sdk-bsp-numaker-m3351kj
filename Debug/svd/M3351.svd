          <fields>
            <field>
              <name>TRGSEL0</name>
              <description>PWM_CH0 Trigger EADC Source Select</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>PWM_CH0 zero point</description>
