      <name>RTC_NS</name>
      <description>RTCNS Register Map</description>
      <groupName>RTCNS</groupName>
      <baseAddress>0x50041000</baseAddress>
      <!-- d -> no access permission -->
      <addressBlock>
        <offset>0x0</offset>
        <size>0x4</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x8</offset>
        <size>0x34</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
