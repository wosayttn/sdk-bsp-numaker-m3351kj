              <name>PA</name>
              <description>Set GPIO Port A to Non-secure State\nWrite 1 to set PA to non-secure state. Each bit configures one pin in GPIO port A.\nNote: This bit is write-protected by SCU_SCWP.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>GPIO port A is secure (default)</description>
                    <value>0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>GPIO port A is non-secure</description>
                    <value>1</value>
                 </enumeratedValue>
