       </register>
       <register derivedFrom="PDMAx_DSCT0_CTL">
          <name>PDMAx_DSCT7_CTL</name>
          <displayName>PDMAx_DSCT7_CTL</displayName>
          <description>Descriptor Table Control Register of PDMA Channel n</description>
          <addressOffset>0x70</addressOffset>
       </register>
       <register derivedFrom="PDMAx_DSCT0_CTL">
          <name>PDMAx_DSCT8_CTL</name>
          <displayName>PDMAx_DSCT8_CTL</displayName>
          <description>Descriptor Table Control Register of PDMA Channel n</description>
          <addressOffset>0x80</addressOffset>
       </register>
       <register derivedFrom="PDMAx_DSCT0_CTL">
          <name>PDMAx_DSCT9_CTL</name>
          <displayName>PDMAx_DSCT9_CTL</displayName>
          <description>Descriptor Table Control Register of PDMA Channel n</description>
          <addressOffset>0x90</addressOffset>
       </register>
       <register derivedFrom="PDMAx_DSCT0_CTL">
          <name>PDMAx_DSCT10_CTL</name>
          <displayName>PDMAx_DSCT10_CTL</displayName>
          <description>Descriptor Table Control Register of PDMA Channel n</description>
          <addressOffset>0xA0</addressOffset>
       </register>
       <register derivedFrom="PDMAx_DSCT0_CTL">
          <name>PDMAx_DSCT11_CTL</name>
          <displayName>PDMAx_DSCT11_CTL</displayName>
          <description>Descriptor Table Control Register of PDMA Channel n</description>
          <addressOffset>0xB0</addressOffset>
       </register>
       <register>
          <name>PDMAx_DSCT0_SA</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>PDMAx_DSCT0_SA</displayName>
          <description>Source Address Register of PDMA Channel n</description>
          <addressOffset>0x4</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000000</resetMask>
          <fields>
            <field>
              <name>SA</name>
              <description>PDMA Transfer Source Address\nThis field indicates a 32-bit source address of PDMA controller.</description>
