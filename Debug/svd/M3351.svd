       <register>
          <name>I3C_EXTTXTHS</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_EXTTXTHS</displayName>
          <description>I3C Target Mode Extended Command Transmit Threshold Status Register</description>
          <addressOffset>0x150</addressOffset>
          <access>read-only</access>
          <resetValue>0x000000FF</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>ECMDTTS0</name>
              <description>EXTCMD0 Transmit Threshold Status\nThis bit is set when the number of empty locations in transmit buffer is greater than or equal to threshold value specified by by TXEBTH (I3C_EXTTHLD[18:16]) setting. \nThis bit is cleared automatically when number of empty locations in transmit buffer is less than threshold value specified.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Number of empty locations in transmit buffer is less than TXEBTH setting</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Number of empty locations in transmit buffer is greater than or equal to TXEBTH setting</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ECMDTTS1</name>
              <description>EXTCMD1 Transmit Threshold Status\nThis bit is set when the number of empty locations in transmit buffer is greater than or equal to threshold value specified by by TXEBTH (I3C_EXTTHLD[18:16]) setting. \nThis bit is cleared automatically when number of empty locations in transmit buffer is less than threshold value specified.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Number of empty locations in transmit buffer is less than TXEBTH setting</description>
                    <value>#0</value>
