       <register>
          <name>I3C_TGT1CHAR1</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_TGT1CHAR1</displayName>
          <description>I3C Target Device 1 Characteristic 1 Register</description>
          <addressOffset>0x200</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000000</resetMask>
          <fields>
            <field>
              <name>PIDMSB</name>
              <description>Device Characteristic 1\nThis field is used in Controller mode of operation.\nThe MSB 32-bit value of Provisional ID.\nNote: This field is read only.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_TGT1CHAR2</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_TGT1CHAR2</displayName>
          <description>I3C Target Device 1 Characteristic 2 Register</description>
          <addressOffset>0x204</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000000</resetMask>
          <fields>
            <field>
              <name>PIDLSB</name>
              <description>Device Characteristic 2\nThis field is used in Controller mode of operation.\nThe LSB 16-bit value of Provisional ID.\nNote: This field is read only.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_TGT1CHAR3</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_TGT1CHAR3</displayName>
          <description>I3C Target Device 1 Characteristic 3 Register</description>
          <addressOffset>0x208</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000000</resetMask>
          <fields>
            <field>
              <name>DCR</name>
              <description>Device Characteristic Value\nThis field is used in Controller mode of operation.\nNote: This field is read only.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>BCR</name>
              <description>Bus Characteristic Value\nThis field is used in Controller mode of operation.\nNote: This field is read only.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_TGT1CHAR4</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_TGT1CHAR4</displayName>
          <description>I3C Target Device 1 Characteristic 4 Register</description>
          <addressOffset>0x20C</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000000</resetMask>
          <fields>
            <field>
              <name>DADDR</name>
              <description>Device Dynamic Address Assigned\nThis field is used in Controller mode of operation.\nDevice Dynamic Address assigned.\nNote: This field is read only.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
       </register>
