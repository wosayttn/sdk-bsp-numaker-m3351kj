                    <description>UART wake-up interrupt flag is generated</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>LINIF</name>
              <description>LIN Bus Interrupt Flag\nNote: This bit is cleared when SLVHDETF (UART_LINSTS[0]), SLVHEF (UART_LINSTS[1]), SLVIDPEF (UART_LINSTS[2]), SLVHTOF (UART_LINSTS[4]), RTOUTF (UART_LINSTS[5]), BRKDETF (UART_LINSTS[8]), and BITEF (UART_LINSTS[9]) all are cleared and software writing '1' to LINIF (UART_INTSTS[7]).</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
