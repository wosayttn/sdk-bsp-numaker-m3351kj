              </enumeratedValues>
            </field>
            <field>
              <name>SOTPREVOKE</name>
              <description>Secure OTP Revoke (Read Only)\nThe flag indicates the end of the life cycle of SOTP. All contents in SOTP would never be accessible when the SOTPREVOKE flag is set.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
