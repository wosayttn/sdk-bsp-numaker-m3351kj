            </field>
            <field>
              <name>TXEBTH</name>
              <description>Extended Transmit Empty Buffer Threshold\nThis field controls the number of empty locations (or above) in the Extended Transmit FIFO that trigger the EXTTXTH (I3C_INTSTS[21]) interrupt. \nThe supported values for TXEBTH are:</description>
              <bitOffset>16</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_GRPA0STS</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_GRPA0STS</displayName>
          <description>I3C Target Mode Group Address 0 Status Register</description>
          <addressOffset>0x1E0</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>GRPADDR</name>
              <description>Target Group Address\nThis field is used to store the Group Address assigned by the Active Controller.\nThe Active Controller assigns this Group Address through SETGRPA CCC. \nTarget mode uses this Group Address to acknowledge the write transfers along with Dynamic Address.\nNote: This field is read only in Target mode of operation and programmable by the application in Secondary Controller Mode.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>7</bitWidth>
            </field>
            <field>
              <name>GRPAVLD0</name>
              <description>Group Address Valid For Target\nThis bit is used to indicate whether the Group Address is valid or not for Target.\nTarget mode sets this bit to 1 when Active Controller assigns the Group Address mentioned in GRPADDR field to Target through SETGRPA CCC. \nNote: The bit will be set to 0 upon receiving RSTGRPA CCC.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>GRPADDR is invalid for Target</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>GRPADDR is valid for Target</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>GRPAVLD1</name>
              <description>Group Address Valid For Virtual Target 1\nThis bit is used to indicate whether the Group Address is valid or not for Virtual Target 1.\nTarget mode sets this bit to 1 when Active Controller assigns the Group Address mentioned in GRPADDR field to Virtual Target 1 through SETGRPA CCC. \nNote: The bit will be set to 0 upon receiving RSTGRPA CCC.</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>GRPADDR is invalid for Virtual Target 1</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>GRPADDR is valid for Virtual Target 1</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>GRPAVLD2</name>
              <description>Group Address Valid For Virtual Target 2\nThis bit is used to indicate whether the Group Address is valid or not for Virtual Target 2.\nTarget mode sets this bit to 1 when Active Controller assigns the Group Address mentioned in GRPADDR field to Virtual Target 2 through SETGRPA CCC. \nNote: The bit will be set to 0 upon receiving RSTGRPA CCC.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>GRPADDR is invalid for Virtual Target 2</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>GRPADDR is valid for Virtual Target 2</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>GRPAVLD3</name>
              <description>Group Address Valid For Virtual Target 3\nThis bit is used to indicate whether the Group Address is valid or not for Virtual Target 3.\nTarget mode sets this bit to 1 when Active Controller assigns the Group Address mentioned in GRPADDR field to Virtual Target 3 through SETGRPA CCC. \nNote: The bit will be set to 0 upon receiving RSTGRPA CCC.</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>GRPADDR is invalid for Virtual Target 3</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>GRPADDR is valid for Virtual Target 3</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>GRPAVLD4</name>
              <description>Group Address Valid For Virtual Target 4\nThis bit is used to indicate whether the Group Address is valid or not for Virtual Target 4.\nTarget mode sets this bit to 1 when Active Controller assigns the Group Address mentioned in GRPADDR field to Virtual Target 4 through SETGRPA CCC. \nNote 1: The bit will be set to 0 upon receiving RSTGRPA CCC.\nNote 2: Group Address 3 dose not support for Virtual Target 4.</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>GRPADDR is invalid for Virtual Target 4</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>GRPADDR is valid for Virtual Target 4</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
       </register>
