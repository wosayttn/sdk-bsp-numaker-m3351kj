          <name>I3C_TGT5CHAR2</name>
          <displayName>I3C_TGT5CHAR2</displayName>
          <description>I3C Target Device 5 Characteristic 2 Register</description>
          <addressOffset>0x244</addressOffset>
       </register>
       <register derivedFrom="I3C_TGT1CHAR3">
          <name>I3C_TGT5CHAR3</name>
          <displayName>I3C_TGT5CHAR3</displayName>
