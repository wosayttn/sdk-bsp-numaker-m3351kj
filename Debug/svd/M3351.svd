            </field>
          </fields>
       </register>
       <register>
          <name>SCU_IONSSET7</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>SCU_IONSSET7</displayName>
          <description>I/O Non-secure Attribution Set Register7</description>
          <addressOffset>0x15C</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>PH</name>
              <description>Set GPIO Port H to Non-secure State\nWrite 1 to set PH to non-secure state. Each bit configures one pin in GPIO port H.\nNote: This bit is write-protected by SCU_SCWP.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>GPIO port H is secure (default)</description>
                    <value>0</value>
