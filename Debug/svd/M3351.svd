          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>SEBDINTEN</name>
              <description>Single Error Bits Detection Interrupt Enable (Write Protect)\nNote: This bit is write protected. Refer to the SYS_REGLCTL register.</description>
