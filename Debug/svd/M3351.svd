       <register>
          <name>SYS_I3C0PADCTL</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>SYS_I3C0PADCTL</displayName>
          <description>I3C0 PAD Control Register</description>
          <addressOffset>0x600</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>SCL_PUCTLEN</name>
              <description>I3C0 SCL PAD Pullup Control Enable Bit\nNote 2: If set to 1, an external pullup resistor is required to provide the pullup function.\nNote 3: Only effective when the I3C0_SCL is selected in multi-function pin selection.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>I3C0 SCL PAD pullup controlled by GPIO(Default)</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>I3C0 SCL PAD pullup controlled by I3C0 controller</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SDA_PUCTLEN</name>
              <description>I3C0 SDA PAD Pullup Control Enable Bit\nNote 2: If set to 1, an external pullup resistor is required to provide the pullup function.\nNote 3: Only effective when the I3C0_SDA is selected in multi-function pin selection.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>I3C0 SDA PAD pullup controlled by GPIO(Default)</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>I3C0 SDA PAD pullup controlled by I3C0 controller</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PA0_MODE1P8V</name>
              <description>PA.0 Additional PMOS/NMOS Enable Bit</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Disable(Default)</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Enable</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PA1_MODE1P8V</name>
              <description>PA.1 Additional PMOS/NMOS Enable Bit</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
