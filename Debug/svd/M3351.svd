          <name>PDMAx_DSCT0_NEXT</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>PDMAx_DSCT0_NEXT</displayName>
          <description>Next Scatter-gather Descriptor Table Address of PDMA Channel n</description>
          <addressOffset>0xC</addressOffset>
