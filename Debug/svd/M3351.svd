                 <enumeratedValue>
                    <name>0</name>
                    <description>EXTCMD Transmit Buffer Threshold Interrupt Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>EXTCMD Transmit Buffer Threshold Interrupt Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_QUESTSLV</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_QUESTSLV</displayName>
          <description>I3C Queue Status Level Register</description>
          <addressOffset>0x4C</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000008</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>CMDELOC</name>
              <description>Command Queue Empty Locations\nThis bit is used in Controller mode of operation. \nContains the number of empty locations in the Command Buffer.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>RESPLV</name>
              <description>Response Buffer Level Value\nContains the number of valid data entries in the Response Buffer.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>IBIBUFLV</name>
              <description>IBI Buffer Level Value \nThis bit is used in Controller mode of operation. \nContains the number of valid IBI Data entries in the IBI Data Buffer.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>IBISCNT</name>
              <description>IBI Status Count\nThis bit is used in Controller mode of operation. \nContains the number of valid IBI Status entries in the IBI Status Buffer.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>5</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_DBSTSLV</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_DBSTSLV</displayName>
          <description>I3C Data Buffer Status Level Register</description>
          <addressOffset>0x50</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000020</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>TXELV</name>
              <description>Transmit Buffer Empty Level Value\nContains the number of empty locations in the Transmit Buffer.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>RXLV</name>
              <description>Receive Buffer Level Value\nContains the number of valid data entries in the Receive Buffer.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_PRESENTS</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_PRESENTS</displayName>
          <description>I3C Present State Register</description>
          <addressOffset>0x54</addressOffset>
          <access>read-only</access>
          <resetValue>0x10000007</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>CTRACTS</name>
              <description>Current Controller Active Status\nThis bit is used in Controller mode of operation.\nThis bit is used to check whether the Controller is current Controller or not. The current Controller is the Controller that owns the SCL line.\nThe Controller is the current Controller and can initiate the transfers on the line.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Controller is not current Controller</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Controller is current Controller</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TFRTYPE</name>
              <description>Transfer Type Status \nIndicates the type of transfer currently executing by the Controller or Target.\nIn Controller mode of operation:</description>
              <bitOffset>8</bitOffset>
              <bitWidth>6</bitWidth>
            </field>
            <field>
              <name>CTRTFRS</name>
              <description>Current Controller Transfer State Status\nThis bit is used in Controller mode of operation. \nIndicates the state of current transfer currently executing by the I3C Controller. </description>
              <bitOffset>16</bitOffset>
              <bitWidth>6</bitWidth>
            </field>
            <field>
              <name>TID</name>
              <description>Transmit Transaction ID \nThis field reflects the Transaction ID of the current executing command.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>CTRIDLES</name>
              <description>Current Controller In IDLE State Or Not \nThis bit is used in Controller mode of operation. \nThis bit is set when all the Queues (Command , Response, IBI) and Buffers (Transmit and Receive) are empty along with the Controller State machine is in IDLE state. </description>
              <bitOffset>28</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Controller is not in IDLE State</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Controller is in IDLE State</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_CCCDEVS</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_CCCDEVS</displayName>
          <description>I3C Target Device Operating Status Register</description>
          <addressOffset>0x58</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>PENDINT</name>
              <description>Pending Interrupt \nThis field reflects the PENDINT (I3C_DEVCTL[6:3]) value.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>PROTERR</name>
              <description>Protocol Error \nThis bit is set when the Target device encouters a Parity/CRC error during write data transfer.\nNote: This bit is cleared only after Controller reads the device status through GETSTATUS CCC.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Protocol Error did not occurred</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Protocol Error occurred</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ACTMODE</name>
              <description>Activity Mode \nThis field is forced to be 0x0.</description>
              <bitOffset>6</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>UDFERR</name>
              <description>Underflow Error \nUnderflow error condition detected during Controller read transfer.\nThis bit is set if Target device terminates a read transfer because of unavailability of data in the transmit buffer. \nNote: This bit is cleared only after Controller reads the device status through GETSTATUS CCC.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Underflow Error did not occurred</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Underflow Error occurred</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SLVBUSY</name>
              <description>Target Busy \nThis bit is set if any change is made by the current Controller in to MRL register or occurance of any error.\nNote: This bit is cleared after Target application resumes the Target operation by writing RESUME bit (I3C_DEVCTL[30]) 1.</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Target not in Busy state</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Target in Busy state</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>OVFERR</name>
              <description>Overflow Error \nOverflow error condition detected during Controller write transfer. \nThis bit is cleared only after Controller reads the device status through GETSTATUS CCC.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DATNRDY</name>
              <description>Data Not Ready\nThis bit is set when private read request from Controller is NACKED because of any of the following conditions:\nCommand FIFO Empty.\nTransmit FIFO threshold is not met. \nResponse FIFO Full.\nNote: This bit is cleared when the Controller issues GETSTATUS CCC or upon successful completion of the subsequent read transfer.</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Data Not Ready did not occurred</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Data Not Ready occurred</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>BFNAVAIL</name>
              <description>Buffer Not Available\nThis bit is set when private write request from Controller is NACKED because of RX buffer not having RXSTATH (I3C_DBTHCTL[26:24]) number of empty locations or response buffer is full.\nNote: In SDR mode of operation, this bit is cleared when the Controller issues GETSTATUS CCC or upon space becoming available in the buffer and the successful completion of the next write transfer. \nNote: In HDR mode of operation, it is cleared only when Controller issues GETSTATUS CCC.</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Buffer Not Available did not occurred</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Buffer Not Available occurred</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FRAMEERR</name>
              <description>Frame Error \nThis bit is set when private write request from Controller has frame error in HDR-DDR mode.\nNote: This bit is cleared only after Controller reads the device status through GETSTATUS CCC.</description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Frame error did not occurred</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Frame error occurred</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_SLVMID</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_SLVMID</displayName>
          <description>I3C Target MIPI Manufacturer ID Register</description>
          <addressOffset>0x70</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>PIDTYPE</name>
              <description>Provisioned ID Type Selector\nThis bit reflects the PID[32]. (PID[47:0] Target Device 48-bit Provisioned ID)</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Vendor Fixed Value</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Random Value</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MID</name>
              <description>MIPI Manufacturer ID\nThis field reflects the PID[47:33]. (PID[47:0] Target Device 48-bit Provisioned ID)</description>
              <bitOffset>1</bitOffset>
              <bitWidth>15</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_SLVPID</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_SLVPID</displayName>
          <description>I3C Target Provisional ID Register</description>
          <addressOffset>0x74</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>ADDLMEAN</name>
              <description>Additional Meaning\nThis field reflects the PID[11:0]. (PID[47:0] Target Device 48-bit Provisioned ID)</description>
              <bitOffset>0</bitOffset>
              <bitWidth>12</bitWidth>
            </field>
            <field>
              <name>INSTID</name>
              <description>Instance ID\nThis field reflects the PID[15:12]. (PID[47:0] Target Device 48-bit Provisioned ID)</description>
              <bitOffset>12</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>PARTID</name>
              <description>Part ID\nThis field reflects the PID[31:16]. (PID[47:0] Target Device 48-bit Provisioned ID)</description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_SLVCHAR</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_SLVCHAR</displayName>
          <description>I3C Target Characteristic Register</description>
          <addressOffset>0x78</addressOffset>
          <access>read-write</access>
          <resetValue>0x00010077</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>MXDSLIMT</name>
              <description>Max Data Speed Limitation \nThis bit reflects the BCR[0].</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>No limitation</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Limitation</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>IBICAP</name>
              <description>IBI Request Capable\nThis bit reflects the BCR[1] and forced to 0x1.\nNote: This bit is read only.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>IBIPL</name>
              <description>IBI Payload\nThis bit reflects the BCR[2] and forced to 0x1.\nNote: This bit is read only.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>OLINECAP</name>
              <description>Offline Capable\nThis bit reflects the BCR[3] and forced to 0x0.\nNote: This bit is read only.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>VIRTAG</name>
              <description>Virtual Target\nThis bit reflects the BCR[4] and forced to 0x1.\nNote: This bit is read only.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ADVCAP</name>
              <description>Advanced Capabilities\nThis bit reflects the BCR[5] value. </description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Does not support optional advanced capabilities</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Supports optional advanced capabilities. Use GETCAPS CCC to determine which ones</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DEVROLE</name>
              <description>Device Role \nThis field reflects the BCR[7:6] and forced to 0x1.\nNote: This bit is read only.</description>
              <bitOffset>6</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>DCR</name>
              <description>I3C Device Characteristic Value\nThis field reflects the DCR[7:0] value.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>HDRCAPV</name>
              <description>I3C Device HDR Capability Value\nForced to 0x1.\nNote: This field is read only.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_SLVMXLEN</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_SLVMXLEN</displayName>
          <description>I3C Target Maximum Write/Read Length Register</description>
          <addressOffset>0x7C</addressOffset>
          <access>read-only</access>
          <resetValue>0x00FF00FF</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>MWL</name>
              <description>I3C Device Max Write Length\nThis field reflects the maximum write length in Target mode.\nIt only can be updated if SETMWL CCC is received.\nNote: This field is read only.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
            <field>
              <name>MRL</name>
              <description>I3C Device Max Read Length\nThis field reflects the maximum read length in Target mode.\nIt only can be updated if SETMRL CCC is received.\nNote: This field is read only.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_MXDS</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_MXDS</displayName>
          <description>I3C Target Maximum Data Speed Register</description>
          <addressOffset>0x84</addressOffset>
          <access>read-write</access>
          <resetValue>0x00080008</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>MXWR</name>
              <description>Maximum Write Data Rate\nSpecifies the Maximum Sustained Data Rate for non-CCC messages sent by Controller device to Target device.\nNote: The 1st byte which returned in the GETMXDS CCC.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
            <field>
              <name>DEFBYTE</name>
              <description>Defining Byte support\nSpecifies the defining byte support of GETMXDS CCC.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Defining byte is not supported for GETMXDS CCC</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Defining byte is supported for GETMXDS CCC</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MXRD</name>
              <description>Maximum Read Data Rate\nSpecifies the Maximum Sustained Data Rate for non-CCC messages sent by Target device to Controller device.  \nNote: The 2nd byte which returned in the GETMXDS CCC.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
            <field>
              <name>STPPERM</name>
              <description>Stop Permit\nSpecifies the STOP support between write and read.</description>
              <bitOffset>19</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>STOP after write will cancel the read</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Target permits the write and read to be seperated by a STOP</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ACTST</name>
              <description>Active State\nThis 2-bit integer indicates whether this I3C device initially acts with a given Activity State, after becoming Active Controller on the Bus according to the Controller handoff flow.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>SETACTST</name>
              <description>Set Activity State \nThis bit indicates whether the Active Controller should set the Bus to the Activity State indicated in ACTST (I3C_MXDS[25:24]) before handing the Controller Role off to this I3C Device as part of the normal flow.</description>
              <bitOffset>26</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>The Target will not set the Bus to any Activity state</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>The Target will set the Bus to any Activity state based on ACTST (I3C_MXDS[25:24])</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_SIR</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_SIR</displayName>
          <description>I3C Target Interrupt Request Control Register</description>
          <addressOffset>0x8C</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>EN</name>
              <description>Enable Target Interrupt Request\nWhen set, the Target attempts to issue the SIR on the I3C bus based on CTL field. \nIf CTL is set to 2'b00, Target clears this bit automatically and update the IBISTS field upon either current Controller accepts through generating (ACK) or If Target is unable to issue the SIR. \nIf CTL is set to 2'b00, Target reattempts the SIR either upon detecting the next START condition from the Controller or after the Bus Available Time If NACK response is received for the SIR. \nIf CTL is set to 2'b01, Target clears this bit automatically after sampling the SCL Low (pulled by Controller) for the generated SDA low. Target will release the SDA line upon sampling the SCL low. This feature is used in CE3 error recovery flow.\nNote: Once set, the application/software cannot clear this bit.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>No effect</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Send Target interrupt request</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CTL</name>
              <description>Target Interrupt Request Control</description>
              <bitOffset>1</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Indicates source of SIR data to be from the I3C_SIRDAT register</description>
                    <value>0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Pull SDA line low and release SDA after sampling SCL low (pulled by Controller). Used for CE3 recovery during Controller Handover procedure</description>
                    <value>1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MR</name>
              <description>Controller Request\nThis bit is available only in the I3C Secondary Controller Configuration, and used for the Secondary Controller requests to be an Active Controller.\nOnce issued and when the current Controller accepts (ACK) or if the Controller is unable to issue the MR, then the Controller clears this bit automatically and updates the IBISTS (I3C_SIRRESP[2:0]) field. \nIf NACK response is received for the MR, the Controller reattempts the MR upon detecting the next START condition from the Controller or after the Bus Available Time.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>No effect</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Secondary Controller issues the MR on the I3C bus</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TS</name>
              <description>Asynchronous Mode-0 Time Stamp\nEnabling this bit will allow the Target to capture the Time-Stamp from external input signal during T_C1 (Target triggers START condition) and T_C2 (IBI is ACK by Controller) markers and append it along with the payload data.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Time-Stamp payload data Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Time-Stamp payload data Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CE3REC</name>
              <description>CE3 Error Recovery\nWhen the conditions for entering CE3 error are met (expiry of application running timer and I3C_SIR[0] (Target Interrupt Request) is not set to 0), the user will program this bit for recovering from CE3 error. \nUpon receiving this bit, the Target will move to Controller mode (update CTRACTS (I3C_PRESENTS[2] to 1) and generate a START (also clear the I3C_SIR[0]) and continue in generating 7E followed by STOP. \nNote: This bit is auto cleared by the Controller after the completion of recovery and moved to Controller mode.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>No effect</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Recovery from CE3 error</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MDB</name>
              <description>Mandatory Data Byte \nThis field gives the mandatory data byte which is required to be transmitted after the Controller ACK the Target address during SIR transfer. \nThis field is only applicable when BCR[2] (I3C_SLVCHAR[2] IBIPL) is set indicating that SIR supports payload data.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>DATLEN</name>
              <description>Target Interrupt Request Data Length \nThis field should be programmed by the Target application to give the data length for the payload data other than the MDB byte. \nThis field is only applicable when BCR[2] (I3C_SLVCHAR[2] IBIPL) is set indicating that SIR supports payload data.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>TGTIDX</name>
              <description>Target Index\nThis field should be programmed by the Target application to select from what Target the SIR is sent.</description>
              <bitOffset>28</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_SIRDAT</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_SIRDAT</displayName>
          <description>I3C Target Interrupt Request Data Register</description>
          <addressOffset>0x94</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>DAT0</name>
              <description>Data Byte 0 \nThis register SIRDATA containing four bytes of SIR Data will be in effect only when SIR CTL (I3C_SIR[2:1]) is programmed to 0 provided the data length is up to 1. \nThis field holds the first byte of SIR DATA that will be passed after the MDB when SIR is initiated by the application on writing into SIR EN (I3C_SIR[0]).</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>DAT1</name>
              <description>Data Byte 1 \nThis register SIRDATA containing four bytes of SIR Data will be in effect only when SIR CTL (I3C_SIR[2:1]) is programmed to 0 provided the data length is up to 2. \nThis field holds the second byte of SIR DATA that will be passed after the MDB when SIR is initiated by the application on writing into SIR EN (I3C_SIR[0]).</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>DAT2</name>
              <description>Data Byte 2 \nThis register SIRDATA containing four bytes of SIR Data will be in effect only when SIR CTL (I3C_SIR[2:1]) is programmed to 0 provided the data length is up to 3. \nThis field holds the third byte of SIR DATA that will be passed after the MDB when SIR is initiated by the application on writing into SIR EN (I3C_SIR[0]).</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>DAT3</name>
              <description>Data Byte 3 \nThis register SIRDATA containing four bytes of SIR Data will be in effect only when SIR CTL (I3C_SIR[2:1]) is programmed to 0 provided the data length is up to 4. \nThis field holds the fourth byte of SIR DATA that will be passed after the MDB when SIR is initiated by the application on writing into SIR EN (I3C_SIR[0]).</description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_SIRRESP</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_SIRRESP</displayName>
          <description>I3C Target Interrupt Request Response Register</description>
          <addressOffset>0x98</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>IBISTS</name>
              <description>IBI Completion Status \nThis field is common for SIR and MR. \nNote: The Target does not attempt to issue the IBI and generates the IBI Completion Status as 3'b011 (IBI Not Attempted) if one of the following condition is true. \nThe Controller has not assigned the Dynamic Address.\nThe Controller has cleared the assigned Dynamic Address (through RSTDAA CCC). \nThe Controller has disabled the IBI event (through DISEC CCC).\nThe Controller has switched the role to Controller (applicable only for Secondary Controller Configuration).\nThe Controller has NACKed the IBI request.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
            <field>
              <name>DATLEN</name>
              <description>SIR Response Data Length\nThe value in this filed will indicate the number of bytes remaining that was not transmitted because of Controller early terminating the SIR transfer. \nIn case the IBI is not attempted the number for bytes returned will be same as that programmed for IBI payload.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_INSTSTS</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_INSTSTS</displayName>
          <description>I3C Target Instant Status Register</description>
          <addressOffset>0xA4</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>INTERSTS</name>
              <description>Target Internal Status \nThis field indicates the internal status of the Target. \nThese bits indicates the internal status of the controller. \nNote: This field is read only.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>6</bitWidth>
            </field>
            <field>
              <name>CCCING</name>
              <description>CCC Transfer On-going \nIndicates a CCC transfer is on-going\nThis bit is asserted after 0x7E header the first bit of CCC is received and it is de-asserted either when a STOP or a 0x7E with a RE-START comes on the I3C line. \nNote 1: This bit is read only.\nNote 2: This bit is synchronized from SCL domain to engine clock domain hence will have some synchronization latency associated with it.</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>No CCC transfer operation</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>CCC transfer is on-going</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>WRING</name>
              <description>Write Transfer On-going \nThis bit is asserted whenever there is an address match for the Controller Write transfer targeted for this Target. \nNote 1: This bit is read only.\nNote 2: This signal remains asserted until the write transfer is over from the Controller. This bit is synchronized from SCL domain to engine clock domain hence will have some synchronization latency associated with it.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>No write transfer operation</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Write transfer is on-going</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>WAKEUP</name>
              <description>Target Wake-up Status\nThis bit indicates the Target is addressed and the application is required to be ready.\nNote 1: This bit is read only.\nNote 2: This bit is de-asserted after an address mismatch or on STOP. It is also de-asserted after a RE-START followed by 0x7E. This bit is synchronized from SCL domain to engine clock domain hence will have some synchronization latency associated with it.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>No address matched event</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>An address match occurs indicating the Controller is trying to access this Target</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_DEVCTLE</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_DEVCTLE</displayName>
          <description>I3C Device Control Extended Register</description>
          <addressOffset>0xB0</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>OPERMODE</name>
              <description>Device Mode\nThis bit is used to select the Device Operation Mode before the device is enabled \nNote 1: This field is written only when the I3C is disabled.\nNote 2: This field is automatically updated once the device role change happens in Secondary Controller mode.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Controller</description>
                    <value>0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Target</description>
                    <value>1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MRACKCTL</name>
              <description>ACK/NACK GETACCCR CCC\nThis bit is used in Target mode of operation.\nThis bit serves as a Target (Secondare Controller) to ACK/NACK GETACCCR CCC from current Controller.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>ACK GETACCCR CCC</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>NACK GETACCCR CCC</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_SCLOD</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_SCLOD</displayName>
          <description>I3C Controller Open Drain SCL Timing Register</description>
          <addressOffset>0xB4</addressOffset>
          <access>read-write</access>
          <resetValue>0x0006001E</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>ODLCNT</name>
              <description>I3C Open Drain Low Count \nSCL Open-Drain Low count for I3C transfers targeted to I3C Targets.\nNote: ODLCNT value can not be set 0 and minimum value is 5.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>ODHCNT</name>
              <description>I3C Open Drain High Count \nSCL Open-Drain High count for I3C transfers targeted to I3C Targets.\nNote: ODHCNT value can not be set 0 and minimum value is 5.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_SCLPP</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_SCLPP</displayName>
          <description>I3C Controller Push Pull SCL Timing Register</description>
          <addressOffset>0xB8</addressOffset>
          <access>read-write</access>
          <resetValue>0x00060006</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>PPLCNT</name>
              <description>I3C Push Pull Low Count \nSCL Push-Pull Low count for I3C transfers targeted to I3C Targets.\nNote: PPLCNT value can not be set 0 and minimum value is 5.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>PPHCNT</name>
              <description>I3C Push Pull High Count \nSCL Push-Pull High count for I3C transfers targeted to I3C Targets.\nNote: PPHCNT value can not be set 0 and minimum value is 5.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_SCLFM</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_SCLFM</displayName>
          <description>I3C Controller I2C Fast Mode SCL Timing Register</description>
          <addressOffset>0xBC</addressOffset>
          <access>read-write</access>
          <resetValue>0x008100E7</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>FMLCNT</name>
              <description>I2C Fast Mode Low Count \nSCL Open-Drain Low count timing for I2C fast mode transfers.\nNote: FMLCNT value can not be set 0 and minimum value is 5.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
            <field>
              <name>FMHCNT</name>
              <description>I2C Fast Mode High Count \nSCL Open-Drain High count timing for I2C fast mode transfers.\nNote: FMHCNT value can not be set 0 and minimum value is 5.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_SCLFMP</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_SCLFMP</displayName>
          <description>I3C Controller I2C Fast Mode Plus SCL Timing Register</description>
          <addressOffset>0xC0</addressOffset>
          <access>read-write</access>
          <resetValue>0x00370059</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>FMPLCNT</name>
              <description>I2C Fast Mode Plus Low Count \nSCL Open-Drain Low count timing for I2C fast mode plus transfers.\nNote: FMPLCNT value can not be set 0 and minimum value is 5.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
            <field>
              <name>FMPHCNT</name>
              <description>I2C Fast Mode Plus High Count \nSCL Open-Drain High count timing for I2C fast mode plus transfers.\nNote: FMPHCNT value can not be set 0 and minimum value is 5.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_SCLEXTLO</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_SCLEXTLO</displayName>
          <description>I3C Controller SCL Extended Low Count Timing Register</description>
          <addressOffset>0xC8</addressOffset>
          <access>read-write</access>
          <resetValue>0x20202020</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>EXTLCNT1</name>
              <description>I3C Extended Low Count 1\nThis field is used for SDR1 speed data transfer.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>EXTLCNT2</name>
              <description>I3C Extended Low Count 2\nThis field is used for SDR2 speed data transfer.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>EXTLCNT3</name>
              <description>I3C Extended Low Count 3\nThis field is used for SDR3 speed data transfer.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>EXTLCNT4</name>
              <description>I3C Extended Low Count 4\nThis field is used for SDR4 speed data transfer.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_SCLEXTTB</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_SCLEXTTB</displayName>
          <description>I3C Controller SCL Extended Termination Bit Low Count Timing Register</description>
          <addressOffset>0xCC</addressOffset>
          <access>read-write</access>
          <resetValue>0x10000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>TERMCNT</name>
              <description>I3C Read Termination Bit Low Count\nExtended I3C Read Termination Bit low count for I3C Read transfers. \nEffective Termination-Bit Low Period is derived based on the SDR speed mode as shown below:\nSDR0 speed: PPLCNT + TERMCNT\nSDR1 speed: EXTLCNT1 + TERMCNT\nSDR2 speed: EXTLCNT2 + TERMCNT\nSDR3 speed: EXTLCNT3 + TERMCNT\nSDR4 speed: EXTLCNT4 + TERMCNT\nNote: The SDR0~4 speed mode is defined in SPEED field (Transfer Command Data Structure [23:21]).</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>STPCNT</name>
              <description>STOP HOLD Count\nStop Hold Count in terms of ECLK which is used for generation of Stop Hold generation in Controller Mode.</description>
              <bitOffset>28</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_SDAHOLD</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_SDAHOLD</displayName>
          <description>I3C Controller SDA Hold And Mode Switch Delay Timing Register</description>
          <addressOffset>0xD0</addressOffset>
          <access>read-write</access>
          <resetValue>0x00010000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>SDAOPDLY</name>
              <description>SDA Open-Drain To Push-Pull Delay\nThe valid value are 0 to 4. Others are Reserved.\nNote: Delay count unit is in terms of the core clock period.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
            <field>
              <name>SDAPODLY</name>
              <description>SDA Push-Pull To Open-Drain Delay\nThe valid value are 0 to 4. Others are Reserved.\nNote: Delay count unit is in terms of the core clock period.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
            <field>
              <name>TXHOLD</name>
              <description>Transmit Hold Time\nThis field is used to control the hold time of SDA during transmit mode in SDR  DDR transfers.\nThe valid values are 1 to 7. Others are Reserved.\nNote: Delay count unit is in terms of the core clock period.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_BUSFAT</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_BUSFAT</displayName>
          <description>I3C Bus Free and Available Timing Register</description>
          <addressOffset>0xD4</addressOffset>
          <access>read-write</access>
          <resetValue>0x00900006</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>FREETC</name>
              <description>Controller Bus Free Time Count\nThis field is used in Controller mode of operation.\nThis field sets the Bus Free Time for initiating the transfer in Controller mode or generating IBI in non-current Controller mode.\nIn Pure Bus System, this field represents tCAS parameter. In Mixed Bus system, this field is expected to be programmed to tLOW of I2C Timing.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
            <field>
              <name>AVAILTC</name>
              <description>Target Bus Avaliable Time Count\nThis field is used in Target mode of operation.\nThis field is used by the Target/Non-current Controller to initiate an IBI after STOP condition.\nNote: Bus Avaliable Time is used for issue In-Band Interrupt.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_BUSIDLET</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_BUSIDLET</displayName>
          <description>I3C Target Bus Idle Timing Register</description>
          <addressOffset>0xD8</addressOffset>
          <access>read-write</access>
          <resetValue>0x00007080</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>IDLETC</name>
              <description>Target Bus Idle Time Count\nThis field is used by the Target to initiate Hot-Join request if the Dynamic Address is not valid.\nNote: Bus Idle Time is used for issue Hot-Join request.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>20</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_SCLLOWTO</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_SCLLOWTO</displayName>
          <description>I3C Controller SCL Low Timeout Register</description>
          <addressOffset>0xDC</addressOffset>
          <access>read-write</access>
          <resetValue>0x003567E0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>LOWCNT</name>
              <description>SCL Low Timeout Count\nThis count defines the number of engine clock periods (SCL Low duration) to count for generation of the SCL Low Bus Reset Pattern.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>26</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_RELSDA</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_RELSDA</displayName>
          <description>I3C Target Release SDA Timing Register</description>
          <addressOffset>0xEC</addressOffset>
          <access>read-write</access>
          <resetValue>0x00004E20</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>RELSDATC</name>
              <description>Release SDA Time Count\nThis field is used in the Target mode of operation to release the SDA upon detecting the SCL not toggling for the programmed time. </description>
              <bitOffset>0</bitOffset>
              <bitWidth>20</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_BTDELY</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_BTDELY</displayName>
          <description>I3C HDR-BT Delay Byte Counter Register</description>
          <addressOffset>0xF4</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000400</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>DLYBCNT</name>
              <description>HDR-BT Delay Byte Count\nThis field is used in Controller and Target mode to control the maximum delay bytes to be accommodated during HDR-BT read transfers.\nFunctionality:\nIn Controller Mode: Accepts delay bytes during HDR-BT read transfer and terminates the next transition control byte if the received delay bytes exceed the programmed value.\nIn Target Mode: Utilizes this field to transmit delay bytes if required number of data bytes are insufficient to frame a HDR-BT Data block.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>11</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>I3C_EXT0DAT</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>I3C_EXT0DAT</displayName>
          <description>I3C Target Mode Extended Command 0 Transfer Data Port Register</description>
          <addressOffset>0x130</addressOffset>
          <access>write-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>EXTDAT</name>
