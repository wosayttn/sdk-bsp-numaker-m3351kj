          <displayName>SCU_SCWP</displayName>
          <description>Security Configuration Write Protect Register</description>
          <addressOffset>0x134</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>LOCK</name>
              <description>Enable Write Protect Lock Bit\nNote: This bit cannot be cleared to 0 without a system-level reset after set to one.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Write Protect lock Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Write Protect Enabled and locked</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>WVCODE</name>
              <description>Write Verify Code\nRead operation:\nReserved, all zeros.\nWrite operation:</description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>18266</name>
                    <description>The write verify code, 0x475A, is needed to do a valid write to SCU_SCWP</description>
                    <value>0x475a</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
