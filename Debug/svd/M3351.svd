            </field>
            <field>
              <name>LDPROEN1</name>
              <description>LDROM Protect Enable (Write Protect)\nThis bit indicates which LDROM region is protected.\nNote 1: LDROM protect region is 0xF10_0000 + n*(0x2000) to 0xF10_1fff + n*(0x2000).\nNote 2: This bit is write protected. Refer to the SYS_REGLCTL register.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>LDROM region n is not protected</description>
                    <value>#0</value>
