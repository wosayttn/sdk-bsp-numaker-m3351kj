       <register>
          <name>EADC_SCTL24</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>EADC_SCTL24</displayName>
          <description>EADC Sample Module 24 Control Register</description>
          <addressOffset>0x244</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>EXTSMPT</name>
              <description>ADC Sampling Time Extend\nWhen EADC converting at high conversion rate, the sampling time of analog input voltage may not enough if input channel loading is heavy, SW can extend ADC sampling time after trigger source is coming to get enough sampling time.\nThe range of start delay time is from 0~255 ADC clock.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
       </register>
       <register derivedFrom="EADC_SCTL24">
          <name>EADC_SCTL25</name>
