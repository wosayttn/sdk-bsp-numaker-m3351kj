                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Rising Edge or Falling edge has been detected</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
