       <register>
          <name>PWM_DACTRGEN</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>PWM_DACTRGEN</displayName>
          <description>PWM Trigger DAC Enable Register</description>
          <addressOffset>0xF4</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>ZTE0</name>
              <description>PWM Zero Point Trigger DAC Enable Bit 0\nPWM can trigger EADC/DAC/DMA to start action when PWM counter down count to zero if this bit is set to1.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>PWM period point trigger DAC function Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>PWM period point trigger DAC function Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ZTE2</name>
              <description>PWM Zero Point Trigger DAC Enable Bit 2\nPWM can trigger EADC/DAC/DMA to start action when PWM counter down count to zero if this bit is set to1.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>PWM period point trigger DAC function Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>PWM period point trigger DAC function Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ZTE4</name>
              <description>PWM Zero Point Trigger DAC Enable Bit 4\nPWM can trigger EADC/DAC/DMA to start action when PWM counter down count to zero if this bit is set to1.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>PWM period point trigger DAC function Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>PWM period point trigger DAC function Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PTE0</name>
              <description>PWM Period Point Trigger DAC Enable Bit 0\nPWM can trigger DAC to start action when PWM counter counts up to (PERIODn+1) if this bit is set to1.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>PWM period point trigger DAC function Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>PWM period point trigger DAC function Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PTE2</name>
              <description>PWM Period Point Trigger DAC Enable Bit 2\nPWM can trigger DAC to start action when PWM counter counts up to (PERIODn+1) if this bit is set to1.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>PWM period point trigger DAC function Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>PWM period point trigger DAC function Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PTE4</name>
              <description>PWM Period Point Trigger DAC Enable Bit 4\nPWM can trigger DAC to start action when PWM counter counts up to (PERIODn+1) if this bit is set to1.</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>PWM period point trigger DAC function Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>PWM period point trigger DAC function Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CUTRGEN0</name>
              <description>PWM Compare Up Count Point Trigger DAC Enable Bits\nPWM can trigger DAC to start action when PWM counter counts up to CMP if this bit is set to1.\nNote 1: This bit should keep at 0 when PWM counter operating in down counter type.\nNote 2: In complementary mode, CUTRGEN1, 3, 5 is used as another CUTRGEN for channel 0, 2, 4.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>PWM Compare Up point trigger DAC function Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>PWM Compare Up point trigger DAC function Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CUTRGEN1</name>
              <description>PWM Compare Up Count Point Trigger DAC Enable Bits\nPWM can trigger DAC to start action when PWM counter counts up to CMP if this bit is set to1.\nNote 1: This bit should keep at 0 when PWM counter operating in down counter type.\nNote 2: In complementary mode, CUTRGEN1, 3, 5 is used as another CUTRGEN for channel 0, 2, 4.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>PWM Compare Up point trigger DAC function Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
