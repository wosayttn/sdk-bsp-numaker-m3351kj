       <register>
          <name>PWM_SWEOFCTL</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>PWM_SWEOFCTL</displayName>
          <description>PWM Software Event Output Force Control Register</description>
          <addressOffset>0x288</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>OUTACTS0</name>
              <description>Output Action Selection</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Do nothing</description>
                    <value>#00</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>PWM output Low</description>
                    <value>#01</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>2</name>
                    <description>PWM output High</description>
                    <value>#10</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>3</name>
                    <description>PWM output Toggle</description>
                    <value>#11</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
