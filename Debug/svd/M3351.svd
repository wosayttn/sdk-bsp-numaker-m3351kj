    <peripheral>
      <name>ELLSI1_NS</name>
      <description>ELLSINS Register Map</description>
      <groupName>ELLSINS</groupName>
      <baseAddress>0x5008B000</baseAddress>
      <!-- d -> no access permission -->
      <addressBlock>
        <offset>0x0</offset>
        <size>0xC4</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
       <register>
          <name>ELLSI_CTL</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>ELLSI_CTL</displayName>
          <description>ELLSI Control Register</description>
          <addressOffset>0x0</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>ELLSIEN</name>
              <description>ELLSI Enable Bit</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>ELLSI Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>ELLSI Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RSTCEN</name>
              <description>Reset Command Function Enable Bit\nNote: If this bit is enabled, when FIFO and shift register are both empty, ELLSI will send reset command out.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Reset command function Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Reset command function Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>UNDFLINTEN</name>
              <description>Underflow Interrupt Enable Bit\nNote: If this bit is enabled, when the UNDFLIF interrupt flag is set to 1, the ELLSI interrupt signal is generated and inform to CPU.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Underflow interrupt Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Underflow interrupt Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FENDINTEN</name>
              <description>Frame End Interrupt Enable Bit\nNote: If this bit is enabled, when the FENDIF interrupt flag is set to 1, the ELLSI interrupt signal is generated and inform to CPU.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Frame end interrupt Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Frame end interrupt Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RSTCINTEN</name>
              <description>Reset Command Interrupt Enable Bit\nNote: If this bit is enabled, when the RSTCIF interrupt flag is set to 1, the ELLSI interrupt signal is generated and inform to CPU.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Reset command interrupt Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Reset command interrupt Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>EMPINTEN</name>
              <description>FIFO Empty Interrupt Enable Bit\nNote: If this bit is enabled, when the EMPIF interrupt flag is set to 1, the ELLSI interrupt signal is generated and inform to CPU.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>FIFO empty interrupt Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>FIFO empty interrupt Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FULINTEN</name>
              <description>FIFO Full Interrupt Enable Bit\nNote: If this bit is enabled, when the FULIF interrupt flag is set to 1, the ELLSI interrupt signal is generated and inform to CPU.</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>FIFO full interrupt Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>FIFO full interrupt Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TXTHIEN</name>
              <description>Transmit FIFO Threshold Interrupt Enable Bit\nNote: This bit is only supported in software mode.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>TX FIFO threshold interrupt Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>TX FIFO threshold interrupt Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ELLSIMODE</name>
              <description>ELLSI Mode Select</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Software mode</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>PDMA mode</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>OFDEF</name>
              <description>Output Format Define</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Output RGB format</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Output GRB format</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TXTH</name>
              <description>Transmit FIFO Threshold\nIf the valid data count of the transmit FIFO buffer is less than or equal to the TXTH setting, the TXTHIF bit will be set to 1, else the TXTHIF bit will be cleared to 0.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>CMDMODE</name>
              <description>Command Mode</description>
              <bitOffset>24</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>LLSI Mode</description>
                    <value>#00</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Normal Command mode. It includes CLR_ID, SET_ID, CHK_ID, SPE_ID, TH20 SET Mode and Feedback mode</description>
                    <value>#01</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>2</name>
                    <description>AUTO SET Mode</description>
                    <value>#10</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>3</name>
                    <description>AUTO TH20 SET Mode</description>
                    <value>#11</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>NCMDDIEN</name>
              <description>Normal Command Done Interrupt Enable Bit</description>
              <bitOffset>27</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Command done interrupt Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Command done interrupt Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RSPIEN</name>
              <description>Normal Command Response Error Interrupt Enable Bit\nNote: Normal Command Responses are SET_ID, CHK_ID, and the error flags are ELLSI_CMDSTS[15:8]</description>
              <bitOffset>28</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Normal Command Response (SET_ID, CHK_ID) Error Interrupt Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Normal Command Response Error Interrupt Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FBSTSIEN</name>
              <description>Feedback Status Interrupt Enable Bit</description>
              <bitOffset>29</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Feedback Status Interrupt Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Feedback Status Interrupt Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ASETIEN</name>
              <description>AUTO SET Mode Interrupt Enable Bit</description>
              <bitOffset>30</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>AUTO SET Mode Interrupt Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>AUTO SET Mode Interrupt Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ATHIEN</name>
              <description>AUTO TH20 SET Mode Interrupt Enable Bit</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>AUTO TH20 SET Mode Interrupt Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>AUTO TH20 SET Mode Interrupt Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
       </register>
       <register>
          <name>ELLSI_RSTPERIOD</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>ELLSI_RSTPERIOD</displayName>
          <description>ELLSI Reset Period Control Register</description>
          <addressOffset>0x4</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>RSTPERIOD</name>
              <description>Reset Command Period\nThis field is used to adjust the time of reset command.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>ELLSI_PERIOD</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>ELLSI_PERIOD</displayName>
          <description>ELLSI Period Control Register</description>
          <addressOffset>0x8</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>PERIOD</name>
              <description>ELLSI Period Register\nThis field is used to define data transfer time (TH+TL).</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>ELLSI_DUTY</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>ELLSI_DUTY</displayName>
          <description>ELLSI Duty Control Register</description>
          <addressOffset>0xC</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>T0H</name>
              <description>T0H Data Register\nThis field is used to define the time of T0H.\nThe time of \n</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>T1H</name>
              <description>T1H Data Register\nThis field is used to define the time of T1H.\nThe time of \n</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>ELLSI_DATA</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>ELLSI_DATA</displayName>
          <description>ELLSI Data Register</description>
          <addressOffset>0x10</addressOffset>
          <access>write-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>DATA</name>
              <description>Data Transmit Register \nThe data transmit registers pass through the transmitted data into the 4-level transmit FIFO buffers.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>ELLSI_PCNT</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>ELLSI_PCNT</displayName>
          <description>ELLSI Pixel Count Register</description>
          <addressOffset>0x14</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>PCNT</name>
              <description>Pixel Count Register\nUser should write a frame size to this register before transfer.\nFor example, if there are a total of 5 LED (5 pixels) in frame, user should write 5 to this control register.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>12</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>ELLSI_CLKDIV</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>ELLSI_CLKDIV</displayName>
          <description>ELLSI Clock Divider Register</description>
          <addressOffset>0x18</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>DIVIDER</name>
              <description>ELLSI Clock Divider\nIt indicates the ELLSI clock, \n+1</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>CMDDIV</name>
              <description>ELLSI Command Clock Divider\nIt indicates the ELLSI command clock, \n_\n+1\n(+1)</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>ELLSI_STATUS</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>ELLSI_STATUS</displayName>
          <description>ELLSI Status Register</description>
          <addressOffset>0x1C</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000002</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>RSTCIF</name>
              <description>Reset Command Interrupt Flag\nThis bit indicates that ELLSI has finished reset command transmission.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>EMPIF</name>
              <description>FIFO Empty Interrupt Flag</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Transmit FIFO buffer is not empty</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Transmit FIFO buffer is empty</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FULIF</name>
              <description>FIFO Full Interrupt Flag</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Transmit FIFO buffer is not full</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Transmit FIFO buffer is full</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TXTHIF</name>
              <description>Transmit FIFO Threshold Interrupt Flag</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>The valid data count within the transmit FIFO buffer is larger than the setting value of TXTH</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>The valid data count within the transmit FIFO buffer is less than or equal to the setting value of TXTH</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>UNDFLIF</name>
              <description>Under Flow Interrupt Flag\nEach transmission ELLSI reads 3 bytes data from the FIFO. This bit is set to 1 when ELLSI reads the FIFO and the valid data in FIFO is less than 3 bytes.\nSoftware can write 1 to clear this bit.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>FENDIF</name>
              <description>Frame End Interrupt Flag\nThis bit indicates that ELLSI has finished data transmission (FIFO empty  shift register empty). When ELLSI transfer finish (FIFO empty  shift register empty) this bit is set to 1.\nUser can use this flag to prepare data in advance.\nSoftware can write 1 to clear this bit.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>LDT</name>
              <description>Last Data Transmit</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>ELLSI_OCTL</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>ELLSI_OCTL</displayName>
          <description>ELLSI Output Control Register</description>
          <addressOffset>0x20</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>IDOS</name>
              <description>Idle Output Control</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Idle will output 0</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Idle will output 1</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
       </register>
       <register>
          <name>ELLSI_CMDCTL</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>ELLSI_CMDCTL</displayName>
          <description>ELLSI Command Control Register</description>
          <addressOffset>0x24</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>ENTERLO</name>
              <description>Enter Command Low Period\nEnter Command Low Period (10us). \n_\n</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>ENTERHI</name>
              <description>Enter Command HI Period\nEnter Command HI Period (40us). \n_\n</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>ELLSI_CMDGPP</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>ELLSI_CMDGPP</displayName>
          <description>ELLSI Command Get Pulse Period Register</description>
          <addressOffset>0x28</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>CMDTOP</name>
              <description>Command Timeout Period Register\nTime period of the command timeout.\n+1\n(+1)\n</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
            <field>
              <name>GETHIP</name>
              <description>Get HI Pulse Period Register\nTime period threshold to check HI Pulse. \n+1\n(+1)\n</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>GETHITOL</name>
              <description>Get HI Pulse Tolerance Register\nIt can set tolerance Get HI Pulse Period.\n+1\n(+1)\n</description>
              <bitOffset>24</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>ELLSI_CMD</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>ELLSI_CMD</displayName>
          <description>ELLSI Command Register</description>
          <addressOffset>0x2C</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>ID</name>
              <description>4-bit Command ID\n4-bit ID.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>CMD</name>
              <description>4-bit Command\n4-bit command.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>CMDGO</name>
              <description>Command Go Bit\nWhen this bit is set, it starts the command.\nThis bit will be cleard automatically by hardware.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SPECMD</name>
              <description>Special Command</description>
              <bitOffset>12</bitOffset>
              <bitWidth>4</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Normal command or no command</description>
                    <value>#0000</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Feedback count command</description>
                    <value>#0001</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>2</name>
                    <description>Feedback ID command</description>
                    <value>#0010</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>3</name>
                    <description>TH20 SET command</description>
                    <value>#0011</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>4</name>
                    <description>Send Data</description>
                    <value>#0100</value>
                 </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PDCMD</name>
              <description>Power-down Command\nWhen sending data, user can use this bit to send 0x5a after data.\nThis bit will be cleard automatically by hardware.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>WKCMD</name>
              <description>Wakeup Command\nWhen sending data, user can use this bit to send wakeup pulse after data.\nThis bit will be cleard automatically by hardware after receiving low pulse.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>ELLSI_CMDSTS</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>ELLSI_CMDSTS</displayName>
          <description>ELLSI Command Status Register</description>
          <addressOffset>0x30</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>CMDDONE</name>
              <description>Normal Command Done\nIt will be set to 1 when Command (SET_ID, CLR_ID, CHK_ID) done in Normal Command Mode.\nSoftware can write 1 to clear this bit.\nNote: NCMDDIEN (ELLSI_CTL[27]) need to be set.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>FBDONE</name>
              <description>Feedback Command Done\nIt will be set to 1 when Feedback Command done in Normal Command Mode.\nSoftware can write 1 to clear this bit.\nNote: FBSTSIEN (ELLSI_CTL[29]) need to be set.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TH20DONE</name>
              <description>TH20 Command Done Flag\nIt will be set to 1 when TH20 SET Command done in Normal Command Mode.\nSoftware can write 1 to clear this bit.\nNote: NCMDDIEN (ELLSI_CTL[27]) need to be set.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SETIDLONG</name>
              <description>Set ID Get Pulse Long Flag\nIt will be set to 1 when the pulse longer than tolerance at Set ID Command Get pulse phase.\nSoftware can write 1 to clear this bit.\nNote: RSPIEN (ELLSI_CTL[28]) need to be set.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CHKIDLONG</name>
              <description>Check ID Get Pulse Long Flag\nIt will be set to 1 when the pulse longer than tolerance at Check ID Command Get pulse phase.\nSoftware can write 1 to clear this bit.\nNote: RSPIEN (ELLSI_CTL[28]) need to be set.</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SETIDSHORT</name>
              <description>Set ID Get Pulse Short Flag\nIt will be set to 1 when the pulse shorter than tolerance at Set ID Command Get pulse phase.\nSoftware can write 1 to clear this bit.\nNote: RSPIEN (ELLSI_CTL[28]) need to be set.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CHKIDSHORT</name>
              <description>Check ID Get Pulse Short Flag\nIt will be set to 1 when the pulse shorter than tolerance at Check ID Command Get pulse phase.\nSoftware can write 1 to clear this bit.\nNote: RSPIEN (ELLSI_CTL[28]) need to be set.</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SETGETOV</name>
              <description>SET ID Get Pulse Overflow Flag\nIt will be set to 1 when ELLSI receive more than one pulse at the Set ID Command Get pulse phase.\nSoftware can write 1 to clear this bit.\nNote: RSPIEN (ELLSI_CTL[28]) need to be set.</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CHKGETOV</name>
              <description>Check ID Get Pulse Overflow Flag\nIt will be set to 1 when ELLSI receive more than one pulse at the Check ID Command Get pulse phase.\nSoftware can write 1 to clear this bit\nNote: RSPIEN (ELLSI_CTL[28]) need to be set.</description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SETGETUN</name>
              <description>SET ID Get Pulse Underflow Flag\nIt will be set to 1 when ELLSI receive less than one pulse at the Set ID Command Get pulse phase.\nSoftware can write 1 to clear this bit.\nNote: RSPIEN (ELLSI_CTL[28]) need to be set.</description>
              <bitOffset>14</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CHKGETUN</name>
              <description>Check ID Get Pulse Underflow Flag\nIt will be set to 1 when ELLSI receive less than one pulse at the Check ID Command Get pulse phase.\nSoftware can write 1 to clear this bit\nNote: RSPIEN (ELLSI_CTL[28]) need to be set.</description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>FBC0LONG</name>
              <description>Feedback Count 0 Pulse Long Flag\nIt will be set to 1 when the feedback count 0 pulse longer than tolerance.\nSoftware can write 1 to clear this bit.\nNote: FBSTSIEN (ELLSI_CTL[29]) need to be set.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>FBC0SHORT</name>
              <description>Feedback Count 0 Pulse Short Flag\nIt will be set to 1 when the feedback count 0 pulse shorter than tolerance.\nSoftware can write 1 to clear this bit.\nNote: FBSTSIEN (ELLSI_CTL[29]) need to be set.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>FBC1LONG</name>
              <description>Feedback Count 1 Pulse Long Flag\nIt will be set to 1 when the feedback count 1 pulse longer than tolerance.\nSoftware can write 1 to clear this bit.\nNote: FBSTSIEN (ELLSI_CTL[29]) need to be set.</description>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>FBC1SHORT</name>
              <description>Feedback Count 1 Pulse Short Flag\nIt will be set to 1 when the feedback count 1 pulse shorter than tolerance.\nSoftware can write 1 to clear this bit.\nNote: FBSTSIEN (ELLSI_CTL[29]) need to be set.</description>
              <bitOffset>19</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>FBID0LONG</name>
              <description>Feedback ID 0 Pulse Long Flag\nIt will be set to 1 when the feedback ID 0 pulse longer than tolerance.\nSoftware can write 1 to clear this bit.\nNote: FBSTSIEN (ELLSI_CTL[29]) need to be set.</description>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>FBID0SHORT</name>
              <description>Feedback ID 0 Pulse Short Flag\nIt will be set to 1 when the feedback ID 0 pulse shorter than tolerance.\nSoftware can write 1 to clear this bit.\nNote: FBSTSIEN (ELLSI_CTL[29]) need to be set.</description>
              <bitOffset>21</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>FBID1LONG</name>
              <description>Feedback ID 1 Pulse Long Flag\nIt will be set to 1 when the feedback ID 1 pulse longer than tolerance.\nSoftware can write 1 to clear this bit.\nNote: FBSTSIEN (ELLSI_CTL[29]) need to be set.</description>
              <bitOffset>22</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>FBID1SHORT</name>
              <description>Feedback ID 1 Pulse Short Flag\nIt will be set to 1 when the feedback ID 1 pulse shorter than tolerance.\nSoftware can write 1 to clear this bit.\nNote: FBSTSIEN (ELLSI_CTL[29]) need to be set.</description>
              <bitOffset>23</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ASETIDOV</name>
              <description>AUTO SET Mode Feedback ID Overflow Flag\nIt will be set to 1 when setting ID 4b'1111, and get two pulses back.\nSoftware can write 1 to clear this bit.\nNote: ASETIEN (ELLSI_CTL[30]) need to be set.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ASETDONE</name>
              <description>AUTO SET Mode Done Flag\nIt will be set to 1 when AUTO SET Mode is done.\nSoftware can write 1 to clear this bit.\nNote: ASETIEN (ELLSI_CTL[30]) need to be set.</description>
              <bitOffset>25</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ATHDONE</name>
              <description>AUTO TH20 SET Mode Done Flag\nIt will be set to 1 when AUTO TH20 SET Mode is done.\nSoftware can write 1 to clear this bit.\nNote: ATHIEN (ELLSI_CTL[31]) need to be set.</description>
              <bitOffset>26</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>IDCNT</name>
              <description>ID Count Register\nNumber of Feedback Pulse. It can also be set when the register is written.\nNote: IDCNT will be updated only when AUTO SET Mode is done.</description>
              <bitOffset>28</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>ELLSI_FBCCTL</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>ELLSI_FBCCTL</displayName>
          <description>ELLSI Feedback Command Control Register</description>
          <addressOffset>0x34</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>FBLOP1</name>
              <description>Feedback Command Low Period 1\nFeedback Command High Period 1. \n1\n_\n1</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>FBHIP1</name>
              <description>Feedback Command HI Period 1\nFeedback Command High Period 1. \n1\n_\n1</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>FBLOP0</name>
              <description>Feedback Command Low Period 0\nFeedback Command Low Period 0. \n0\n_\n0</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>FBHIP0</name>
              <description>Feedback Command HI Period 0\nFeedback Command High Period 0. \n0\n_\n0</description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
       </register>
       <register>
          <name>ELLSI_FBCTCTL</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>ELLSI_FBCTCTL</displayName>
          <description>ELLSI Feedback Count Timing Control Register</description>
          <addressOffset>0x38</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>FBCNT0</name>
              <description>Feedback Count 0 Period Register\nTime period threshold to check Feedback Count 0. \n0\n+1\n(+1)\n0</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>FBC0TOL</name>
              <description>Feedback Count 0 Tolerance Register\nIt can set tolerance Feedback Count 0 Pulse Period.\n0\n+1\n(+1)\n0</description>
              <bitOffset>8</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>FBCNT1</name>
              <description>Feedback Count 1 Period Register\nTime period threshold to check Feedback Count 1. \n+1\n(+1)\n1</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>FBC1TOL</name>
              <description>Feedback Count 1 Tolerance Register\nIt can set tolerance Feedback Count 1 Pulse Period.\n1\n+1\n(+1)\n1</description>
              <bitOffset>24</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
